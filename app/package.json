{
  "name": "kovalink",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "build:preview": "eas build -p ios --profile preview",
    "build:production": "eas build -p ios --profile production",
    "check": "npm run typecheck && npm run lint && npm test",
    "eas-build-post-install": "npx tsc -b --force ../packages/protocol && test -f ../packages/protocol/dist/index.js",
    "lint": "eslint .",
    "ota": "eas update --channel preview",
    "protocol:sync": "npm --prefix .. run build",
    "start": "npm run protocol:sync && expo start --go --clear",
    "test": "node --import ./test/register.mjs --test test/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kovalink/protocol": "file:../packages/protocol",
    "expo": "~57.0.21",
    "expo-camera": "~57.0.4",
    "expo-constants": "~57.0.17",
    "expo-crypto": "~57.0.2",
    "expo-file-system": "~57.0.6",
    "expo-haptics": "~57.0.2",
    "expo-image-picker": "~57.0.16",
    "expo-linking": "~57.0.9",
    "expo-local-authentication": "~57.0.2",
    "expo-network": "~57.0.1",
    "expo-notifications": "~57.0.17",
    "expo-router": "~57.0.20",
    "expo-secure-store": "~57.0.3",
    "expo-sharing": "~57.0.18",
    "expo-splash-screen": "~57.0.8",
    "expo-sqlite": "~57.0.2",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.3",
    "expo-task-manager": "~57.0.16",
    "expo-updates": "~57.0.21",
    "markdown-it": "^14.3.2",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-webview": "13.16.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@bacons/apple-targets": "^5.0.0",
    "@types/markdown-it": "^14.2.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.0",
    "eslint-config-expo": "~57.0.2",
    "expo-build-properties": "~57.0.17",
    "typescript": "~5.9.3"
  }
}
